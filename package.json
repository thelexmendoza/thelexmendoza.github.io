    "fonts": "node scripts/copy-fonts.mjs",
    "serve": "node scripts/serve.mjs",
    "icons": "node scripts/build-icons.mjs",
    "test": "node --test tests/",
    "sheet": "node scripts/contact-sheet.mjs",
    "case": "node scripts/build-case.mjs",
    "legal": "node scripts/render-legal.mjs",
    "seo": "node scripts/build-seo.mjs",
    "promo": "node scripts/render-promo.mjs",
    "guia": "node scripts/render-guia.mjs",
    "tags": "node scripts/build-tags.mjs"
  },
  "keywords": [],
